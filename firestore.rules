rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'khyhajmr08@gmail.com') ||
        request.auth.uid == 'PqXqqCgdC1eYPz4HKHHLtDRejPD3'
      );
    }

    function isStaffMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }

    function hasStaffRole(role) {
      return isOwner() || (
        isStaffMember() &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == role
      );
    }

    function isUserRole(role) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffRole == role
        );
    }

    function isAdmin() {
      return isOwner() || isStaffMember() || isUserRole('admin');
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isOwner() || hasStaffRole('services_manager') || isUserRole('admin');
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // New accounts can only create a normal user profile.
      allow create: if isOwner() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'user' &&
        request.resource.data.blocked == false &&
        request.resource.data.referralsCount == 0 &&
        request.resource.data.referralEarnings == 0 &&
        request.resource.data.isReferralRewarded == false &&
        !request.resource.data.keys().hasAny([
          'staffRole', 'isAdmin', 'permissions', 'balance', 'isStaff', 'active'
        ])
      );

      // Customers may edit profile/KYC submission data, but never roles, balances,
      // moderation state, referral counters, or approval state.
      allow update: if isOwner() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'staffRole', 'referralsCount', 'referralEarnings',
          'isReferralRewarded', 'balance', 'blocked', 'isAdmin',
          'permissions', 'active', 'isStaff', 'accountStatus',
          'loyaltyPoints', 'referralCode', 'referredBy'
        ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'reviewStatus', 'kyc_completed', 'isVerified'
          ]) ||
          (
            resource.data.reviewStatus != 'Approved' &&
            resource.data.reviewStatus != 'Verified' &&
            request.resource.data.reviewStatus == 'Under Review' &&
            request.resource.data.kyc_completed == false &&
            (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false)
          )
        )
      );
      allow delete: if isOwner();
    }

    match /staff/{staffId} {
      allow read: if isOwner() || (isSignedIn() && request.auth.uid == staffId);
      allow write: if isOwner();
    }

    match /audit_logs/{logId} {
      allow read: if isOwner();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow get: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        (resource.data.isGuest == true && resource.data.trackingToken is string && resource.data.trackingToken.size() >= 24);

      // Authenticated users can create only for themselves and only while not blocked.
      // Guest checkout remains enabled until the secured backend tracking migration is deployed.
      allow create: if (
        (
          isSignedIn() &&
          request.resource.data.userId == request.auth.uid &&
          (
            !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true
          )
        ) ||
        (
          !isSignedIn() &&
          request.resource.data.isGuest == true &&
          request.resource.data.userId.matches('^guest_[a-zA-Z0-9_-]+$') &&
          request.resource.data.trackingToken is string &&
          request.resource.data.trackingToken.size() >= 24
        )
      ) &&
      request.resource.data.status == 'pending' &&
      request.resource.data.amount is number &&
      request.resource.data.amount >= 0 &&
      request.resource.data.serviceId is string &&
      (!('pinCode' in request.resource.data) || request.resource.data.pinCode == null) &&
      (!('adminNote' in request.resource.data) || request.resource.data.adminNote == null) &&
      (!('rejectionReason' in request.resource.data) || request.resource.data.rejectionReason == null) &&
      (!('completedAt' in request.resource.data) || request.resource.data.completedAt == null);

      allow update: if isOwner() || hasStaffRole('orders_manager') || isUserRole('orders_manager') || isUserRole('admin');
      allow delete: if isOwner();
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      );
      allow delete: if isOwner() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isOwner() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner();
    }

    match /kyc_requests/{userId} {
      allow read: if isOwner() || hasStaffRole('orders_manager') || isUserRole('admin') ||
        (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId &&
        (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false) &&
        (!('reviewStatus' in request.resource.data) || request.resource.data.reviewStatus == 'pending' || request.resource.data.reviewStatus == 'Under Review');
      allow update: if isOwner() || hasStaffRole('orders_manager') || isUserRole('admin') || (
        isSignedIn() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isVerified', 'reviewStatus', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'adminNote'
        ])
      );
      allow delete: if isOwner();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner() || isUserRole('admin');
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if isOwner() || hasStaffRole('services_manager') || isUserRole('admin');
    }

    match /active_visitors/{sessionId} {
      allow read: if isAdmin();
      allow create, update: if
        request.resource.data.keys().hasOnly(['sessionId', 'isRegistered', 'device', 'path', 'lastActive']) &&
        request.resource.data.keys().hasAll(['sessionId', 'isRegistered', 'device', 'path', 'lastActive']) &&
        request.resource.data.sessionId == sessionId &&
        request.resource.data.isRegistered is bool &&
        request.resource.data.device in ['Mobile', 'Desktop'] &&
        request.resource.data.path is string &&
        request.resource.data.path.size() <= 240 &&
        request.resource.data.lastActive is timestamp;
      allow delete: if isAdmin();
    }
  }
}
